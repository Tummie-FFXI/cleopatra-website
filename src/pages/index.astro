---
import { getCollection } from 'astro:content';
import '../styles/global.css';
const news = (await getCollection('news')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()).slice(0,3);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric', timeZone:'UTC' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0d121c" />
  <meta name="description" content="Cleopatra XI — a Final Fantasy XI private server. Explore features, news, and how to begin your adventure." />
  <title>Cleopatra XI — A New Chapter in Vana'diel</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2">
</head>
<body>
<header class="site-header">
  <div class="nav-wrap">
    <a href="/" class="wordmark" aria-label="Cleopatra XI home"><img src="/images/cleopatra-logo.png" alt="Cleopatra XI" class="nav-logo" /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation">☰</button>
    <nav id="main-nav" class="nav-links" aria-label="Main navigation">
      <a href="#home">Home</a><a href="#news">News</a><a href="#features">Features</a><a href="/custom-content/">Custom Content</a><a href="#getting-started">Getting Started</a><a href="#getting-started">Wiki</a><a href="#community">Community</a>
      <a class="nav-cta" href="#getting-started">DOWNLOAD LAUNCHER <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<main>
  <section id="home" class="hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-inner container">
      <h1 class="hero-title"><img src="/images/cleopatra-logo.png" alt="Cleopatra XI" class="hero-logo"/></h1>
      <p class="hero-lede">RELIVE THE ADVENTURE.<br/>FOR A NEW GENERATION.</p>
      <p class="hero-copy">A classic level 75 journey with custom content, thoughtful refinements, and the spirit of Vana'diel at its heart.</p>
      <div class="hero-actions"><a class="btn btn-gold" href="#getting-started">DOWNLOAD LAUNCHER <span>↓</span></a><a class="btn btn-outline" href="#features">LEARN MORE <span>→</span></a></div>
    </div>
  </section>
  <section class="highlights" aria-label="Cleopatra highlights"><div class="container highlights-grid">
    <div><span class="highlight-icon">⚔</span><div><h3>CUSTOM CONTENT</h3><p>Powered by XIPivot integration into the Cleopatra Launcher, the server features refined armor and weapons, along with entirely new weapon skills, bringing fresh possibilities to the world of Vana'diel.</p></div></div>
    <div><span class="highlight-icon">♟</span><div><h3>ADVANCED TRUST SYSTEM</h3><p>Experience a reimagined Trust system where players can customize their Trusts' support jobs, unlocking new combat possibilities. With advanced AI and behavior that goes far beyond retail FFXI, your companions become more versatile and capable allies throughout Vana'diel.</p></div></div>
    <div><span class="highlight-icon">⚙</span><div><h3>QUALITY OF LIFE</h3><p>Experience Vana'diel your way. Whether adventuring solo or alongside a party, Cleopatra XI is designed to deliver the same rewarding experience, ensuring every player can enjoy the world of Final Fantasy XI without being limited by party requirements.</p></div></div>
    <div><span class="highlight-icon">✧</span><div><h3>DEDICATED DEVELOPMENT</h3><p>Cleopatra XI is committed to continuous improvement, with ongoing updates, gameplay refinements, and new features. We're always exploring ways to enhance the experience, keeping Vana'diel fresh, engaging, and evolving for every adventurer.</p></div></div>
  </div></section>
  <section id="news" class="section news-section container"><div class="news-main"><div class="section-heading"><div><span class="kicker">THE LATEST FROM CLEOPATRA</span><h2>Latest <i>News</i></h2></div><a class="section-note" href="#news">DEVELOPMENT UPDATES →</a></div><div class="news-grid">{news.map((post, i)=><a class="news-card" href={`/news/${post.id}/`}><div class={`news-art news-art-${i+1}`}><span class="art-symbol">{i===0?'✦':'⚔'}</span></div><div class="news-body"><div class="meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></div><h3>{post.data.title}</h3><p>{post.data.summary}</p><span class="read-more">READ ARTICLE →</span></div></a>)}</div></div><aside class="status-panel"><div class="status-title"><h2>SERVER STATUS</h2><span class="status-pending">NOT CONNECTED</span></div><p>Live server status will appear here when the game server's status API is connected.</p><div class="status-row"><span>Level Cap</span><strong>75</strong></div><div class="status-row"><span>Server</span><strong>Cleopatra XI</strong></div><div class="status-row"><span>Player Count</span><strong>—</strong></div><a href="#getting-started">GETTING STARTED →</a></aside></section>
  <section id="features" class="section features-section"><div class="container"><div class="section-heading"><div><span class="kicker">THE CLEOPATRA EXPERIENCE</span><h2>Familiar World. <i>New Possibilities.</i></h2></div></div><div class="features-grid"><article class="feature"><div class="feature-icon">⚔</div><h3>Classic Level 75</h3><p>Experience an adventure centered on the classic level 75 era and its distinctive sense of progression.</p></article><article class="feature"><div class="feature-icon">✧</div><h3>Refined Weapon Skills</h3><p>Discover our ongoing work on weapon skill balance and job-specific combat options.</p></article><article class="feature"><div class="feature-icon">◈</div><h3>Custom Equipment</h3><p>Explore thoughtful adjustments to equipment and progression, including artifact armor.</p></article><article class="feature"><div class="feature-icon">♜</div><h3>Built for Adventurers</h3><p>A dedicated launcher, clear installation guides, and an evolving community experience.</p></article></div></div></section>
  <section id="getting-started" class="section container start-section"><div class="start-panel"><div><span class="kicker">YOUR STORY AWAITS</span><h2>Begin Your <i>Adventure.</i></h2><p>Prepare your Final Fantasy XI installation, configure Windower 4 or Ashita 4, and get ready to explore Cleopatra XI.</p><div class="steps"><span><b>01</b> Install FFXI</span><span><b>02</b> Set up your loader</span><span><b>03</b> Install Cleopatra Launcher</span></div><p class="small-note">Launcher download and full setup guide links will be added when published.</p></div><div class="start-ornament" aria-hidden="true">XI</div></div></section>
  <section id="community" class="community-section"><div class="container community-inner"><span class="kicker">MORE THAN A SERVER</span><h2>Find Your <i>Fellow Adventurers.</i></h2><p>Follow development news, share discoveries, and help shape the future of Cleopatra XI.</p><p class="community-note">Community links coming soon</p></div></section>
</main>
<footer class="footer"><div class="container footer-inner"><div><div class="wordmark">CLEOPATRA <span>XI</span></div><p>An independent Final Fantasy XI private server project.</p></div><div class="footer-links"><a href="#home">Home</a><a href="#news">News</a><a href="#features">Features</a><a href="#getting-started">Getting Started</a></div></div><div class="container legal">Cleopatra XI is an independent fan project and is not affiliated with or endorsed by Square Enix. Final Fantasy XI and related marks belong to their respective owners.</div></footer>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.nav-links');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); });
  nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{nav.classList.remove('open');toggle?.setAttribute('aria-expanded','false');}));
</script>
</body></html>

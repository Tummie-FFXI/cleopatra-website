---
import '../styles/global.css';
import '../styles/changes.css';

const categories = [
  {
    id: 'combat', icon: '⚔', title: 'Combat & Gameplay', subtitle: 'Weapon skills, combat mechanics, and battle systems.',
    groups: [
      { title: 'Weapon Skills', items: [
        'Selected existing weapon skills are being rebalanced.',
        'Select jobs will receive new job-specific weapon skills at 225 combat skill.'
      ] }
    ]
  },
  {
    id: 'jobs', icon: '♟', title: 'Jobs & Abilities', subtitle: 'Job identities, traits, and abilities.',
    groups: [
      { title: 'Playable Jobs', items: [
        'Geomancer and Rune Fencer are playable jobs.',
        'Geomancer and Rune Fencer artifact armor follows the level 50 scaling system.'
      ] },
      { title: 'Job Traits', items: [
        'New and revised job traits are being designed for select jobs.'
      ] }
    ]
  },
  {
    id: 'equipment', icon: '◈', title: 'Equipment & Items', subtitle: 'Artifact armor, weapons, and expansion rewards.',
    groups: [
      { title: 'Artifact Armor & Weapons', items: [
        'All artifact armor pieces become equippable at level 50.',
        'Artifact armor stats increase every five levels through level 75.',
        'Artifact weapons are being reworked for level 50–75 progression.'
      ] },
      { title: 'Expansion Rewards', items: [
        'Selected rewards from different expansions can activate cross-expansion set bonuses.',
        'Chains of Promathia rings retain their original stats and contribute to set bonuses.'
      ] }
    ]
  },
  {
    id: 'trusts', icon: '♜', title: 'Trusts & Companions', subtitle: 'Smarter allies and new customization options.',
    groups: [
      { title: 'Trust AI', items: [
        'Trust AI is being redesigned for role-aware combat decisions.',
        'Trust positioning will account for frontline and backline roles.',
        'Trusts will respond more intelligently to changing battle conditions.'
      ] },
      { title: 'Trust Customization', items: [
        'Special quests will unlock one of four support-job options for eligible Trusts.'
      ] }
    ]
  },
  {
    id: 'progression', icon: '✧', title: 'Content & Progression', subtitle: 'Quests, expansion access, and endgame adventures.',
    groups: [
      { title: 'Expansion Access', items: [
        'Custom quests will unlock early access to Sky.',
        'Custom quests will unlock early access to Sea.'
      ] },
      { title: 'Initial Endgame', items: [
        'Paragon Prologue — triggered ground kings.',
        'Paragon Chapter I — Sky.',
        'City Dynamis is planned for the initial release.'
      ] },
      { title: 'Future Endgame', items: [
        'Paragon Chapter II — Sea Jailers (future release).',
        'Paragon Chapter III — Treasures of Aht Urhgan kings (future release).'
      ] }
    ]
  },
  {
    id: 'quality', icon: '⚙', title: 'Quality of Life', subtitle: 'Tools and improvements for a smoother adventure.',
    groups: [
      { title: 'Launcher', items: [
        'Cleopatra Launcher installs and updates the custom game files.',
        'Launcher supports saved Windower 4 and Ashita 4 profiles.'
      ] },
      { title: 'Adventuring', items: [
        'Progression is being designed to support solo players and parties of different sizes.'
      ] }
    ]
  },
  {
    id: 'custom', icon: '✦', title: 'Custom Content', subtitle: 'Original systems and additions created for Cleopatra XI.',
    groups: [
      { title: 'Original Additions', items: [
        'New equipment and rewards will expand character progression options.',
        'Custom systems and content will be introduced as development continues.'
      ] }
    ]
  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0d121c" />
  <meta name="description" content="Explore the full list of Cleopatra XI gameplay changes, including jobs, artifact armor, Trusts, and endgame content." />
  <title>Full List of Changes — Cleopatra XI</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
<style>
  /* Compact patch-note lists; overrides the original card layout in changes.css. */
  .changes-category-body .changes-entries.changes-compact-list {
    display: block;
    grid-template-columns: none;
    padding: 4px 0;
  }
  .changes-list-group { padding: 13px 0 12px; }
  .changes-list-group + .changes-list-group { border-top: 1px solid rgba(177,145,93,.20); }
  .changes-list-group h3 {
    margin: 0 0 12px;
    color: #d8b476;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.06rem;
    font-weight: 400;
    letter-spacing: .035em;
  }
  .changes-list-group ul { list-style: none; margin: 0; padding: 0; }
  .changes-list-group li.changes-entry {
    display: block;
    position: relative;
    margin: 0;
    padding: 5px 0 5px 23px;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: #c9cbd1;
    font-size: .95rem;
    line-height: 1.6;
  }
  .changes-list-group li.changes-entry::before {
    content: '◆';
    position: absolute;
    top: 7px;
    left: 1px;
    color: #c8a069;
    font-size: .62rem;
  }
  .changes-list-group li.changes-entry[hidden] { display: none !important; }
  .changes-list-group[hidden] { display: none !important; }
</style>
</head>
<body>
<header class="site-header">
  <div class="nav-wrap">
    <a href="/" class="wordmark" aria-label="Cleopatra XI home"><img src="/images/cleopatra-logo.png" alt="Cleopatra XI" class="nav-logo" /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation">☰</button>
    <nav id="main-nav" class="nav-links" aria-label="Main navigation">
      <a href="/">Home</a><a href="/#news">News</a><a href="/features/">Features</a><a href="/custom-content/">Custom Content</a><a href="/#getting-started">Getting Started</a><a href="/#getting-started">Wiki</a><a href="/#community">Community</a>
      <a class="nav-cta" href="/#getting-started">DOWNLOAD LAUNCHER <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<main>
  <section class="changes-hero">
    <div class="container changes-hero-inner">
      <span class="kicker">A REIMAGINED VANA'DIEL</span>
      <h1>Full List of <em>Changes</em></h1>
      <p>Explore the refinements and new experiences being developed for Cleopatra XI. Select a category to see what's changing.</p>
    </div>
  </section>
  <section class="container changes-content" aria-label="Game changes">
    <div class="changes-toolbar">
      <label class="changes-search-wrap">
        <span class="sr-only">Search changes</span>
        <span aria-hidden="true">⌕</span>
        <input id="changes-search" type="search" placeholder="Search changes, jobs, equipment…" autocomplete="off" />
      </label>
      <div class="changes-toolbar-actions">
        <button id="expand-all" type="button">Expand All</button>
        <button id="collapse-all" type="button">Collapse All</button>
      </div>
    </div>
    <div id="changes-list" class="changes-list">
      {categories.map((category, index) => (
        <details class="changes-category" data-category={category.id} open={index === 0}>
          <summary>
            <div class="changes-art" aria-hidden="true"><!-- Add a category image here later, e.g. <img src="/images/changes/combat.jpg" alt="" /> --></div>
            <span class="changes-category-icon" aria-hidden="true">{category.icon}</span>
            <span class="changes-category-label"><strong>{category.title}</strong><small>{category.subtitle}</small></span>
            <span class="changes-chevron" aria-hidden="true">⌄</span>
          </summary>
          <div class="changes-category-body">
            <div class="changes-entries changes-compact-list">
              {category.groups.map((group) => (
                <section class="changes-list-group">
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => (
                      <li class="changes-entry">{item}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>
    <p id="changes-no-results" class="changes-empty" hidden>No changes match your search. Try a different term.</p>
    <p class="changes-disclaimer">Development roadmap: descriptions and availability may change as features are implemented and tested. Status labels indicate plans or work in progress, not confirmed live availability.</p>
    <div class="changes-bottom"><a class="btn btn-gold" href="/features/">EXPLORE FEATURES <span aria-hidden="true">→</span></a></div>
  </section>
</main>
<footer class="footer">
  <div class="container footer-inner"><div><div class="wordmark">CLEOPATRA <span>XI</span></div><p>An independent Final Fantasy XI private server project.</p></div><div class="footer-links"><a href="/">Home</a><a href="/#news">News</a><a href="/features/">Features</a><a href="/changes/" aria-current="page">Full List of Changes</a><a href="/#getting-started">Getting Started</a></div></div>
  <div class="container legal">Cleopatra XI is an independent fan project and is not affiliated with or endorsed by Square Enix. Final Fantasy XI and related marks belong to their respective owners.</div>
</footer>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.nav-links');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { nav.classList.remove('open'); toggle?.setAttribute('aria-expanded', 'false'); }));

  const categories = [...document.querySelectorAll<HTMLDetailsElement>('.changes-category')];
  const search = document.querySelector<HTMLInputElement>('#changes-search');
  const empty = document.querySelector<HTMLElement>('#changes-no-results');
  const filter = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    categories.forEach(category => {
      const title = category.querySelector('.changes-category-label')?.textContent?.toLowerCase() ?? '';
      const entries = [...category.querySelectorAll<HTMLElement>('.changes-entry')];
      const categoryMatches = title.includes(query);
      let entryCount = 0;
      entries.forEach(entry => {
        const match = !query || categoryMatches || (entry.textContent?.toLowerCase().includes(query) ?? false);
        entry.hidden = !match;
        if (match) entryCount++;
      });
      category.querySelectorAll<HTMLElement>('.changes-list-group').forEach(group => {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('.changes-entry')].some(entry => !entry.hidden);
      });
      category.hidden = entryCount === 0;
      if (entryCount) visible++;
      if (query && entryCount) category.open = true;
    });
    if (empty) empty.hidden = visible !== 0;
  };
  search?.addEventListener('input', filter);
  document.querySelector('#expand-all')?.addEventListener('click', () => categories.filter(c => !c.hidden).forEach(c => c.open = true));
  document.querySelector('#collapse-all')?.addEventListener('click', () => categories.forEach(c => c.open = false));
</script>
</body>
</html>

---
import '../../styles/global.css';
import '../../styles/wiki.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Wiki — Cleopatra XI</title>
    <meta
      name="description"
      content="Cleopatra XI Wiki: Trusts, jobs, equipment, and custom systems."
    />
  </head>
  <body>
    <header class="site-header">
      <div class="nav-wrap">
        <a href="/" class="wordmark"
          ><img
            src="/images/cleopatra-logo.png"
            alt="Cleopatra XI"
            class="nav-logo" /></a
        ><button
          class="menu-toggle"
          aria-controls="main-nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          ☰
        </button>
        <nav id="main-nav" class="nav-links" aria-label="Main navigation">
          <a href="/">Home</a><a href="/#news">News</a
          ><a href="/features/">Features</a
          ><a href="/custom-content/">Custom Content</a
          ><a href="/#getting-started">Getting Started</a
          ><a href="/wiki/" aria-current="page">Wiki</a
          ><a href="/#community">Community</a
          ><a class="nav-cta" href="/#getting-started">DOWNLOAD LAUNCHER ↗</a>
        </nav>
      </div>
    </header>
    <section class="wiki-banner">
      <div class="container">
        <span class="wiki-kicker">CLEOPATRA XI KNOWLEDGE BASE</span>
        <h1>Vana'diel <em>Wiki</em></h1>
        <p>Explore companions, systems, equipment, and the adventures ahead.</p>
      </div>
    </section>
    <div class="container wiki-shell">
      <aside class="wiki-sidebar">
        <div class="wiki-sidebar-heading">WIKI NAVIGATION</div>
        <a class="wiki-side-link active" href="/wiki/">Overview</a>
        <div class="wiki-side-heading">TRUSTS</div>
        <div class="wiki-side-link" href="/wiki/trust-system/">The Cleopatra Trust System</a>
        <a class="wiki-side-link" href="/wiki/trusts/">Trust Compendium</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/adelheid/">Adelheid</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/ayam/">Ayame</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/curilla/">Curilla</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/darcuilln/">Darcuilln</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/elivira/">Elivira</a >
        <a class="wiki-side-link sub" href="/wiki/trusts/excenmille/">Excenmille</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/iron_eater/">Iron Eater</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/kupipi/">Kupipi</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/najelith/">Najelith</a >
        <a class="wiki-side-link sub" href="/wiki/trusts/naji/">Naji</a>
        <a class="wiki-side-link sub" href="/wiki/trusts/nanaa/">Nanaa Mihgo</a >
        <a class="wiki-side-link sub" href="/wiki/trusts/semih_lafinah/">Semih Lafinah</a >
        <a class="wiki-side-link sub" href="/wiki/trusts/zeid/">Zeid</a >
        <div class="wiki-side-heading">JOBS</div>
        <span class="wiki-side-link muted">Job Changes · Coming soon</span
        ><span class="wiki-side-link muted">Weapon Skills · Coming soon</span>
        <div class="wiki-side-heading">EQUIPMENT</div>
        <span class="wiki-side-link muted">Artifact Armor · Coming soon</span
        ><span class="wiki-side-link muted">Set Bonuses · Coming soon</span>
        <div class="wiki-side-heading">CONTENT</div>
        <span class="wiki-side-link muted">Paragon Endgame · Coming soon</span
        ><span class="wiki-side-link muted">Feretory · Coming soon</span>
      </aside>
      <main class="wiki-main">
        <div class="wiki-breadcrumb"><a href="/">Home</a> › Wiki</div>
        <div class="wiki-panel wiki-intro">
          <span class="wiki-kicker">WELCOME, ADVENTURER</span>
          <h2>Knowledge for a New Journey</h2>
          <p>
            Browse the Cleopatra XI systems and learn how your companions make
            decisions. The Trust Compendium is our first detailed wiki section.
          </p>
          <a class="wiki-button" href="/wiki/trusts/">EXPLORE TRUSTS →</a>
        </div>
        <div class="wiki-card-grid">
          <a class="wiki-link-card" href="/wiki/trusts/"
            ><span>♟</span>
            <h3>Trust Compendium</h3>
            <p>
              Companions, support jobs, healing thresholds, and AI behavior.
            </p>
            <strong>Browse Trusts →</strong></a
          >
          <div class="wiki-link-card wiki-coming">
            <span>⚔</span>
            <h3>Jobs & Abilities</h3>
            <p>Job changes and custom weapon skills.</p>
            <small>COMING SOON</small>
          </div>
          <div class="wiki-link-card wiki-coming">
            <span>◈</span>
            <h3>Equipment</h3>
            <p>Artifact armor, rewards, and set bonuses.</p>
            <small>COMING SOON</small>
          </div>
          <div class="wiki-link-card wiki-coming">
            <span>✧</span>
            <h3>Content & Systems</h3>
            <p>Feretory, Paragon, Dynamis, and progression.</p>
            <small>COMING SOON</small>
          </div>
        </div>
      </main>
    </div>
    <footer class="footer">
      <div class="container legal">
        Cleopatra XI is an independent fan project and is not affiliated with or
        endorsed by Square Enix.
      </div>
    </footer>
    <script>
      const t=document.querySelector<HTMLButtonElement>('.menu-toggle');const n=document.querySelector<HTMLElement>('.nav-links');t?.addEventListener('click',()=>{const open=t.getAttribute('aria-expanded')!=='true';t.setAttribute('aria-expanded',String(open));n?.classList.toggle('open',open)});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{n.classList.remove('open');t?.setAttribute('aria-expanded','false')}));
    </script>
  </body>
</html>

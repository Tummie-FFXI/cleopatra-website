---
import '../styles/global.css';
import '../styles/features.css';

const features = [
  {
    id: 'artifact-armor',
    title: 'Reimagined Artifact Armor',
    icon: '◈',
    image: '', // e.g. '/images/features/artifact-armor.jpg'
    paragraphs: [
      "Artifact Armor has been reworked with enhanced stats that better complement each job's unique strengths and playstyle. All Artifact Armor pieces can now be equipped at level 50, with stats that increase every five levels up to the level cap.",
      'Each piece displays its stat ranges, allowing players to see how their equipment improves as they level. This ensures your iconic job-specific armor remains useful throughout your adventures.'
    ]
  },
  {
    id: 'expansion-rewards',
    title: 'Expansion Rewards & Set Bonuses',
    icon: '✧',
    image: '',
    paragraphs: [
      'New and enhanced equipment rewards have been introduced across the expansions, from Rise of the Zilart through Wings of the Goddess. Rewards earned from different expansions can be equipped together to activate special set bonuses, encouraging players to collect and combine equipment from multiple storylines.',
      'The iconic Chains of Promathia rings retain their original stats but now contribute to these set bonuses. By combining expansion rewards, adventurers can gain additional benefits beyond the individual stats of each piece.'
    ]
  },
  {
    id: 'trust-system',
    title: 'Reimagined Trust System',
    icon: '♟',
    image: '',
    paragraphs: [
      'Experience a completely rebuilt Trust system featuring advanced AI designed from the ground up to mimic the behavior and decision-making of real players. With smarter combat logic, heightened situational awareness, and role-specific playstyles, Trusts respond dynamically to the battlefield rather than relying on predictable routines.',
      'For example, Ulmia intelligently moves into range of frontline party members to perform melee-focused songs before repositioning to the backline to provide support songs for mages, remaining safely behind the battle afterward.',
      "Further customize your Trust companions through special unlock quests that grant access to one of four available subjobs. Each subjob introduces new abilities and alters the Trust's combat behavior, allowing players to shape their companions' roles and strategies to better complement their party."
    ]
  },
  {
    id: 'weapon-skills',
    title: 'New & Reimagined Weapon Skills',
    icon: '⚔',
    image: '',
    paragraphs: [
      'Weapon Skills have been revisited and refined, with adjustments to their damage, properties, and overall effectiveness. These changes aim to improve the usefulness of existing Weapon Skills, giving players more viable options in combat rather than relying on only a handful of powerful choices.',
      'Additionally, select jobs gain access to completely new Weapon Skills at 225 combat skill, expanding their arsenal with unique abilities and new combat possibilities.'
    ]
  },
  {
    id: 'sky-sea',
    title: 'Early Access to Sky & Sea',
    icon: '◇',
    image: '',
    paragraphs: [
      'Unlock access to the iconic endgame areas of Sky and Sea without having to complete their respective expansion storylines. Through special quests, adventurers can gain early entry to these legendary regions, allowing them to explore and participate in endgame content while progressing through the main story at their own pace.'
    ]
  },
  {
    id: 'geo-run',
    title: 'Geomancer & Rune Fencer',
    icon: '✦',
    image: '',
    paragraphs: [
      'Geomancer (GEO) and Rune Fencer (RUN) are fully available as playable jobs, bringing their unique abilities and playstyles to Cleopatra XI. Both jobs also feature their iconic Artifact Armor, available starting at level 50 allowing them to benefit from the same stat-scaling system as other Artifact Armor sets.'
    ]
  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0d121c" />
  <meta name="description" content="Explore Cleopatra XI's reimagined Artifact Armor, expansion set bonuses, advanced Trust AI, new Weapon Skills, Sky and Sea access, and playable GEO and RUN." />
  <title>Features — Cleopatra XI</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a href="/" class="wordmark" aria-label="Cleopatra XI home"><img src="/images/cleopatra-logo.png" alt="Cleopatra XI" class="nav-logo" /></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Toggle navigation">☰</button>
      <nav id="main-nav" class="nav-links" aria-label="Main navigation">
        <a href="/#home">Home</a>
        <a href="/#news">News</a>
        <a href="/features/" aria-current="page">Features</a>
        <a href="/custom-content/">Custom Content</a>
        <a href="/#getting-started">Getting Started</a>
        <a href="/#getting-started">Wiki</a>
        <a href="/#community">Community</a>
        <a class="nav-cta" href="/#getting-started">DOWNLOAD LAUNCHER <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="features-hero" aria-labelledby="features-title">
      <div class="container features-hero-inner">
        <span class="kicker">THE CLEOPATRA EXPERIENCE</span>
        <h1 id="features-title">Features</h1>
        <p class="features-hero-tagline">A familiar world, reimagined with new possibilities.</p>
        <p class="features-hero-description">Discover the custom systems and gameplay enhancements of Cleopatra XI, built to honor the spirit of Final Fantasy XI while creating a fresh and expanded experience.</p>
      </div>
    </section>

    <section class="feature-catalog container" aria-label="Cleopatra XI gameplay features">
      {features.map((feature) => (
        <article class="feature-panel" id={feature.id}>
          <div class="feature-panel-art">
            {feature.image ? (
              <img src={feature.image} alt={`${feature.title} illustration`} loading="lazy" />
            ) : (
              <div class="feature-image-placeholder" aria-label="Image to be added">
                <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="7" y="9" width="34" height="30" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="17" cy="18" r="3" stroke="currentColor" stroke-width="1.5"/><path d="m10 35 11-11 7 7 5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>IMAGE COMING SOON</span>
              </div>
            )}
          </div>
          <div class="feature-panel-copy">
            <div class="feature-panel-heading"><span class="feature-panel-icon" aria-hidden="true">{feature.icon}</span><h2>{feature.title}</h2></div>
            <div class="feature-panel-divider" aria-hidden="true"><span>✧</span></div>
            {feature.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      ))}
    </section>

    <section class="all-changes" aria-labelledby="all-changes-title">
      <div class="container all-changes-inner">
        <span class="kicker">EXPLORE EVERYTHING</span>
        <div class="changes-ornament" aria-hidden="true">✧</div>
        <h2 id="all-changes-title">See Full List of Changes</h2>
        <p>Explore the complete list of custom content, gameplay adjustments, equipment changes, and quality-of-life improvements.</p>
        <!-- Change this URL when the full changes page is published. -->
        <a class="btn btn-gold changes-button" href="/custom-content/">SEE FULL LIST OF CHANGES <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div><div class="wordmark">CLEOPATRA <span>XI</span></div><p>An independent Final Fantasy XI private server project.</p></div>
      <div class="footer-links"><a href="/#home">Home</a><a href="/#news">News</a><a href="/features/">Features</a><a href="/#getting-started">Getting Started</a></div>
    </div>
    <div class="container legal">Cleopatra XI is an independent fan project and is not affiliated with or endorsed by Square Enix. Final Fantasy XI and related marks belong to their respective owners.</div>
  </footer>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('.nav-links');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('open', open);
    });
    nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      nav.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    }));
  </script>
</body>
</html>
